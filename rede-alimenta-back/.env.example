# Copie para .env e substitua pela conexao do seu banco (as tabelas sao criadas por python migrar.py ou ao iniciar o servidor).
DATABASE_URL=postgresql://usuario:senha@host:5432/banco?sslmode=require

# Token Bearer exigido em /api/*. Gere um valor unico: python -c "import secrets; print(secrets.token_urlsafe(32))"
# O servidor nao inicia sem um token com 32+ caracteres. Nunca versione o valor real.
API_TOKEN=troque-por-um-token-aleatorio-com-32-ou-mais-caracteres
# O painel /admin e o portal das ONGs entram por conta (e-mail e senha, sessao de 12h). Nao ha senha unica de painel:
# o API_TOKEN so vale para o Swagger e scripts. O primeiro gestor se cria com: python criar_gestor.py "Nome" email@x.org
# 1 (padrao): ao iniciar, o servidor aplica o esquema e as migracoes (aditivas e idempotentes, nunca apagam dados).
# Use 0 se preferir rodar `python migrar.py` manualmente.
AUTO_MIGRAR=1
# Defina 1 somente atras de proxy confiavel (Render/Hugging Face) para usar X-Forwarded-For/Proto.
TRUST_PROXY=0

# Segredo que assina os links de acesso das ONGs (32+ caracteres). Se ficar vazio, e derivado do API_TOKEN.
ONG_LINK_SECRET=

# Validacao do alimento por IA (gratuita). Camadas: bloqueio local, lista local e IA; sem confirmacao, o item NAO e cadastrado.
# Os provedores sao tentados em ordem; se o primeiro falhar (cota, queda), o segundo assume.
# Principal: Groq (chave gratuita em console.groq.com)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=
# Reserva: Gemini (chave gratuita no Google AI Studio)
LLM2_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM2_MODEL=gemini-2.5-flash
LLM2_API_KEY=
# Somente desenvolvimento: 1 libera itens desconhecidos quando nenhuma IA responde (o padrao e recusar).
ALIMENTO_FALHA_ABERTA=0
